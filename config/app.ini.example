; =====================================================================
; AISLE 主設定檔範本
; 部署時複製為 config/app.ini 並填入實際值（app.ini 不要進版控）
;   cp config/app.ini.example config/app.ini && chmod 640 config/app.ini
; =====================================================================

[app]
name      = "AISLE"
timezone  = "Asia/Taipei"
; production 時請設為 0
debug     = 0
; 瀏覽器看到的網址路徑（不含主機名稱），結尾不加斜線
; 經過 proxy 時要包含 proxy 的前綴：
;   http://sccproxyauth-a-dc1-38.scc.f18.tsmc.com/D1C1/aisle/  →  "/D1C1/aisle"
;   直接連主機 http://host/aisle/                              →  "/aisle"
;   DocumentRoot 指向 public/、網站在網域根目錄                 →  ""
base_url  = "/D1C1/aisle"

[database]
host     = "127.0.0.1"
port     = 3306
name     = "aisle"
user     = "aisle_app"
password = "請改成強密碼"
charset  = "utf8mb4"

[security]
; bcrypt 成本，10~12 之間；越高越安全但登入越慢
bcrypt_cost      = 10
; 連續失敗幾次後鎖定
max_failed_login = 5
; 鎖定分鐘數
lock_minutes     = 15
; 閒置幾秒自動登出
session_idle     = 1800
; HTTPS 環境請設為 1
cookie_secure    = 0

[chart_demo]
; 圖表 Demo 頁的資料來源（見 modules/chart_demo/ChartDataSource.php）
;   sample  內建範例資料（預設）
;   db      PHP 直接查 MariaDB，需先實作 ChartDataSource.php 的「部署者實作區」
;   script  呼叫 scripts/python/chart_data.py 取得 JSON
source = "sample"
; source = script 時使用的 Python 2.7 直譯器
python = "python"
